DEBUG=

DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=            # например: "localhost" или "db" для docker-compose
DATABASE_PORT=5432

# Задайте имя и пароль суперпользователя для установки через кастомную команду
